# Copy to .env and edit. Never commit .env.
API_KEY=change-me-to-a-long-random-string      # required by clients as X-API-Key; empty disables auth (dev only)
MLFLOWOPS_HOME=./.mlflowops                    # DB + datasets + model artifacts
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=                           # default: sqlite file under MLFLOWOPS_HOME; docker-compose uses http://mlflow:5000
MLFLOW_EXPERIMENT=mlflowops
MAX_UPLOAD_MB=25
DRIFT_PSI_THRESHOLD=0.2
PERF_DROP_THRESHOLD=0.05                       # retrain if live accuracy < baseline - this
MIN_DRIFT_SAMPLES=30
MIN_FEEDBACK_SAMPLES=20
API_URL=http://localhost:8000                  # used by the dashboard
MLFLOW_UI_URL=http://localhost:5000
